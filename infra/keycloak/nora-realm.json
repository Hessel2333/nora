      "credentials": [{ "type": "password", "value": "nora-local-only", "temporary": false }],
      "realmRoles": ["nora_recipe_manager"]
    },
    {
      "username": "planner",
      "enabled": true,
      "firstName": "生产",
      "lastName": "计划员",
      "email": "planner@nora.local",
      "emailVerified": true,
      "attributes": { "organization_id": ["00000000-0000-4000-8000-000000000001"] },
      "credentials": [{ "type": "password", "value": "nora-local-only", "temporary": false }],
      "realmRoles": ["nora_planner"]
