    },
    {
      "username": "operator",
      "enabled": true,
      "firstName": "现场",
      "lastName": "操作员",
      "email": "operator@nora.local",
      "emailVerified": true,
      "attributes": { "organization_id": ["00000000-0000-4000-8000-000000000001"] },
      "credentials": [{ "type": "password", "value": "nora-local-only", "temporary": false }],
      "realmRoles": ["nora_production_operator"]
    },
    {
