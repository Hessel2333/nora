{
  "name": "nora",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "dev": "next dev",
    "dev:web": "NORA_NEXT_DIST_DIR=.next-dev next dev",
    "dev:api": "pnpm --dir apps/api start:dev",
    "dev:full": "pnpm setup:local && concurrently -n WEB,API -c blue,green \"pnpm dev:web\" \"pnpm dev:api\"",
    "build": "next build",
    "build:web": "next build",
    "build:api": "pnpm --dir apps/api build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "pnpm typecheck:web && pnpm typecheck:api",
    "typecheck:web": "next typegen && tsc --noEmit",
    "typecheck:api": "pnpm --dir apps/api typecheck",
    "test": "pnpm test:web && pnpm test:api",
    "test:web": "vitest run --exclude 'apps/api/**'",
    "test:api": "pnpm --dir apps/api test",
    "test:smoke": "bash scripts/smoke-order-bom.sh",
    "setup:local": "pnpm db:up && pnpm db:deploy && pnpm db:seed",
    "auth:up": "docker compose up -d keycloak && node scripts/wait-keycloak.mjs",
    "auth:down": "docker compose stop keycloak",
    "auth:verify": "node scripts/verify-local-identity.mjs",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --dir apps/api prisma:generate",
    "db:migrate": "pnpm --dir apps/api prisma:migrate",
    "db:deploy": "pnpm --dir apps/api prisma:deploy",
    "db:seed": "pnpm --dir apps/api prisma:seed",
    "db:studio": "pnpm --dir apps/api prisma:studio",
    "docs:check": "node scripts/check-doc-links.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.4.0",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-select": "2.3.3",
    "@radix-ui/react-tabs": "1.1.17",
    "@tanstack/react-table": "8.21.3",
    "clsx": "2.1.1",
    "echarts": "6.1.0",
    "echarts-for-react": "3.0.6",
    "keycloak-js": "26.2.4",
    "lucide-react": "1.24.0",
    "next": "15.5.20",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.81.0",
    "tailwind-merge": "3.6.0",
    "three": "^0.185.1",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.4",
    "concurrently": "10.0.5",
    "eslint": "^9.39.0",
    "eslint-config-next": "15.5.20",
    "tailwindcss": "4.3.2",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
